# Copy to .env.local for local development. Never commit real values.
# Both values are public by design (they ship to the browser); data access is enforced by
# Row Level Security in the database. NEVER put the service_role key in any VITE_ variable.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / publishable key
VITE_SUPABASE_ANON_KEY=your-anon-key
